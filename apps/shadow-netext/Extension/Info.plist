<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>dev.shadow.netext.extension</string>
	<key>CFBundleName</key>
	<string>Shadow Capture</string>
	<key>CFBundlePackageType</key>
	<string>SYSX</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSSystemExtensionUsageDescription</key>
	<string>Shadow routes your apps' connections through the local Shadow proxy so data sent to AI services can be masked.</string>
	<key>NetworkExtension</key>
	<dict>
		<key>NEMachServiceName</key>
		<string>$(TeamIdentifierPrefix)dev.shadow.netext.extension</string>
		<key>NEProviderClasses</key>
		<dict>
			<key>com.apple.networkextension.app-proxy</key>
			<string>$(PRODUCT_MODULE_NAME).TransparentProxyProvider</string>
		</dict>
	</dict>
</dict>
</plist>
