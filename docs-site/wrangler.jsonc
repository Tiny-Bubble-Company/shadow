// Cloudflare Worker for https://getshadow.dev: the static site in dist/ plus the www -> apex
// redirect in worker/index.js. Deployed by .github/workflows/deploy-site.yml on every push to
// main: pnpm build, then `node deploy/csp.mjs dist dist/_headers`, then `wrangler deploy`.
{
	"name": "shadow-docs",
	"main": "./worker/index.js",
	"compatibility_date": "2025-06-01",
	// Served only on the custom domains, not on a workers.dev subdomain.
	"workers_dev": false,
	// First-party funnel events from POST /api/e (see worker/README.md).
	"analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "shadow_funnel" }],
	// Help and feedback from Shadow Hub, emailed through Email Routing. SUPPORT_INBOX must be a
	// verified destination address; SUPPORT_RELAY_TOKEN is a secret shared with the Hub server.
	"send_email": [{ "name": "SUPPORT_MAIL" }],
	// Forms: add the KV namespace once created (see worker/README.md):
	// "kv_namespaces": [{ "binding": "FORMS", "id": "<namespace id>" }],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Run the Worker first so www requests are redirected even for paths that exist.
		"run_worker_first": true,
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	}
}
