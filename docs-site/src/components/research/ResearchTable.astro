---
// Responsive data table for research articles with stat/comparison data.
interface Props {
	headers: string[];
	rows: string[][];
	caption?: string;
	footer?: string;
}

const { headers, rows, caption, footer } = Astro.props;
---

<figure class="research-table-wrap">
	{caption && <figcaption class="research-table-caption">{caption}</figcaption>}
	<div class="research-table-scroll">
		<table class="research-table">
			<thead>
				<tr>
					{headers.map((h) => <th set:html={h} />)}
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr>
							{row.map((cell, i) => (i === 0 ? <th scope="row" set:html={cell} /> : <td set:html={cell} />))}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	{footer && <p class="research-table-footer">{footer}</p>}
</figure>

<style>
	.research-table-wrap {
		margin: 2.5rem 0;
		max-width: 100%;
	}

	.research-table-caption {
		margin-bottom: 1rem;
		font-size: 1.125rem;
		font-weight: 600;
		color: oklch(96% 0.006 285);
		letter-spacing: -0.01em;
	}

	.research-table-scroll {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		border: 1px solid var(--sh-border);
		border-radius: var(--sh-radius);
		background: var(--sh-panel);
	}

	.research-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 1rem;
		line-height: 1.65;
	}

	.research-table th,
	.research-table td {
		padding: 1rem 1.25rem;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--sh-border);
	}

	.research-table thead {
		background: var(--sh-raised);
	}

	.research-table thead th {
		font-size: 0.875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: oklch(96% 0.006 285);
		border-bottom: 2px solid var(--sh-border-strong);
	}

	.research-table tbody th {
		font-weight: 600;
		color: oklch(96% 0.006 285);
	}

	.research-table tbody td {
		color: oklch(88% 0.008 285);
	}

	.research-table tbody tr:last-child th,
	.research-table tbody tr:last-child td {
		border-bottom: 0;
	}

	.research-table tbody tr:hover th,
	.research-table tbody tr:hover td {
		background: var(--sh-hover);
	}

	.research-table :global(strong) {
		font-weight: 600;
		color: oklch(96% 0.006 285);
	}

	.research-table-footer {
		margin: 1rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: oklch(82% 0.01 285);
	}

	@media (max-width: 40rem) {
		.research-table {
			font-size: 0.9375rem;
		}

		.research-table th,
		.research-table td {
			padding: 0.875rem 1rem;
		}

		/* Prevent text from becoming tiny on mobile */
		.research-table thead th {
			font-size: 0.8125rem;
			white-space: nowrap;
		}

		/* First column readable width on mobile */
		.research-table tbody th:first-child {
			min-width: 140px;
		}
	}
</style>
