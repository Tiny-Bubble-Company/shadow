---
import Section from './Section.astro';
import { LINKS } from './links';

// Held-out test set results from the benchmarks page. Keep in sync with /benchmarks/.
const rows = [
	{ name: 'Shadow + NER sidecar', leak: 0.09, shadow: true },
	{ name: 'Shadow + Presidio detector', leak: 1.33, shadow: true },
	{ name: 'Shadow, built-in rules only', leak: 3.08, shadow: true },
	{ name: 'OpenAI Privacy Filter', leak: 11.01 },
	{ name: 'GLiNER', leak: 13.28 },
	{ name: 'Microsoft Presidio', leak: 20.74 },
	{ name: 'LLM Guard', leak: 29.26 },
];
const max = 30;
const fmt = (n: number) => `${n.toFixed(2)}%`;
const stats = [
	{ value: '3.08%', label: 'of sensitive values leaked with built-in rules alone' },
	{ value: '~8 ms', label: 'per document with built-in rules' },
	{ value: '0%', label: 'public names changed by mistake' },
	{ value: '100%', label: 'exact round trip back to the original text' },
];
---

<Section
	id="benchmarks"
	eyebrow="Benchmarks"
	title="Leaks less than standalone detectors"
	lead="Measured on a held-out test set with a reproducible benchmark: the share of sensitive values that still reached the model. Lower is better."
>
	<figure class="hp-bench surface" data-bench>
		<figcaption class="hp-bench__head">
			<span>Sensitive values leaked</span>
			<span class="hp-bench__legend"><span><i class="is-shadow"></i>Shadow</span><span><i></i>Standalone tools</span></span>
		</figcaption>
		<table class="hp-bench__table">
			<caption class="sr-only">Share of sensitive values leaked on the held-out test set, lower is better</caption>
			<thead class="sr-only">
				<tr><th scope="col">Tool</th><th scope="col">Leaked</th></tr>
			</thead>
			<tbody>
				{
					rows.map((r, i) => (
						<tr class:list={{ 'is-shadow': r.shadow }}>
							<th scope="row">{r.name}</th>
							<td class="hp-bench__bar">
								<span class="hp-bench__track">
									<span class="hp-bench__fill" style={`--w:${Math.max((r.leak / max) * 100, 0.6)}%;--d:${i * 110}ms`} />
								</span>
							</td>
							<td class="hp-bench__val">{fmt(r.leak)}</td>
						</tr>
					))
				}
			</tbody>
		</table>
		<p class="hp-note">Share of sensitive values leaked on the held-out test set, lower is better</p>
	</figure>
	<ul class="hp-figures">
		{
			stats.map((s) => (
				<li>
					<strong>{s.value}</strong>
					<span>{s.label}</span>
				</li>
			))
		}
	</ul>
	<p class="hp-aside hp-aside--wide">
		On a third-party set of financial documents in seven languages (Gretel), every tool leaks more and GLiNER on its own
		leaks less than Shadow's built-in rules; the benchmarks page has both results.
	</p>
	<a class="hp-more" href={LINKS.benchmarks}>Methodology, datasets and full results <span aria-hidden="true">→</span></a>
</Section>

<script>
	// Grow the bars once the chart is in view (they are full width without JS).
	const chart = document.querySelector<HTMLElement>('[data-bench]');
	if (chart && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		chart.classList.add('is-armed');
		const io = new IntersectionObserver(([e]) => {
			if (e!.isIntersecting) {
				chart.classList.add('is-in');
				io.disconnect();
			}
		}, { threshold: 0.3 });
		io.observe(chart);
	}
</script>
