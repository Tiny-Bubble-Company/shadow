---
// Home page: the two products (Core free and open source, Hub for teams), then how teams roll
// it out with the key facts. Prices come from src/data/pricing.ts, Hub links from src/data/hub.ts.
import Section from './Section.astro';
import InstallCmd from './InstallCmd.astro';
import { HUB_FROM } from '../../data/pricing';
import { hub } from '../../data/hub';
import { CATALOG_LABEL } from './catalog';
import { LINKS } from './links';

const steps = [
	{ title: 'Install Core', text: 'Free, on each laptop or server.' },
	{ title: 'shadow hub connect', code: true, text: 'Each machine joins your Hub workspace, after the person confirms.' },
	{ title: 'Invite the team', text: 'Send invite links; MDM rollout is on the way.' },
	{ title: 'Watch the dashboard', text: 'What was protected, by whom, in which tool.' },
];
const facts = [
	{ value: 'Apache-2.0', label: 'Free and open source' },
	{ value: 'Single binary', label: 'macOS, Linux, Windows' },
	{ value: 'No cloud', label: 'No account, no telemetry' },
	{ value: CATALOG_LABEL, label: 'OpenAI, Anthropic, Gemini…' },
];
---

<section id="products" class="hp-sec reveal not-content" aria-label="Shadow Core and Shadow Hub">
	<div class="hp-wrap">
		<div class="hp-products">
			<article class="hp-product surface">
				<p class="hp-product__kicker">Free · open source · Apache-2.0</p>
				<h2>Shadow Core</h2>
				<p class="hp-product__text">
					For individuals and servers. A local proxy that masks PII and secrets before they reach any AI service, and
					restores them in the answer. No account, no telemetry.
				</p>
				<InstallCmd prompt={false} class="hp-product__install" />
				<a class="sh-btn sh-btn--fg hp-product__cta" href={LINKS.quickStart}>Quick start <span aria-hidden="true">→</span></a>
			</article>
			<article class="hp-product surface">
				<p class="hp-product__kicker">For teams · {HUB_FROM}</p>
				<h2>Shadow Hub</h2>
				<p class="hp-product__text">
					See what was masked or blocked, by user, tool and AI service, across every laptop and server. One dashboard for
					your security team: {hub.trial}.
				</p>
				<a class="sh-btn sh-btn--primary hp-product__cta" href={LINKS.hub}>See Shadow Hub <span aria-hidden="true">→</span></a>
			</article>
		</div>
	</div>
</section>

<Section id="rollout" title="How teams roll it out">
	<ol class="hp-steps">
		{
			steps.map((s, i) => (
				<li>
					<span class="hp-steps__n">{String(i + 1).padStart(2, '0')}</span>
					<h3>{s.code ? <code>{s.title}</code> : s.title}</h3>
					<p>{s.text}</p>
				</li>
			))
		}
	</ol>
	<ul class="hp-facts" aria-label="Key facts">
		{
			facts.map((f) => (
				<li>
					<strong>{f.value}</strong>
					<span>{f.label}</span>
				</li>
			))
		}
	</ul>
</Section>
