---
import Section from './Section.astro';
import { Image } from 'astro:assets';
import LivePanel from './LivePanel.astro';
import { product } from '../../assets/product';

const metrics = [
	{ label: 'Traffic monitored', text: 'Every AI request on the machine, by destination and by the app that sent it.' },
	{ label: 'Sensitive data masked', text: 'What was swapped for fakes, broken down by data type: people, emails, keys, IBANs.' },
	{ label: 'Requests blocked', text: 'What your file policy refused to send at all, such as images or PDFs, and why.' },
];
const img = { decoding: 'async' as const, loading: 'lazy' as const };
---

<Section
	id="activity"
	eyebrow="Activity dashboard"
	title="See what’s leaking"
	lead="Find out what your AI tools actually send before anything leaves the machine: how much traffic goes to which model, what Shadow masked, and what it blocked."
>
	<div class="hp-notes hp-notes--ruled">
		{
			metrics.map((m) => (
				<div>
					<h3>{m.label}</h3>
					<p>{m.text}</p>
				</div>
			))
		}
	</div>

	<LivePanel />

	<div class="hp-shots">
		<figure class="surface">
			<Image
				src={product.tray}
				{...img}
				widths={[420, 840]}
				sizes="(min-width: 48rem) 34rem, 100vw"
				alt="Shadow menu-bar app showing protection status, live counts of masked values and the most recent masked AI requests."
			/>
			<figcaption>
				<h3>Menu bar</h3>
				<p>A status icon on Mac and Windows with live counts and the dashboard one click away.</p>
			</figcaption>
		</figure>
		<figure class="surface">
			<Image
				src={product.terminal}
				{...img}
				widths={[640, 1000, 1600]}
				sizes="(min-width: 48rem) 34rem, 100vw"
				alt="The shadow top command in a terminal: live counts of AI requests and masked values, broken down by destination provider and source app."
			/>
			<figcaption>
				<h3><code>shadow top</code></h3>
				<p>The same live view in your terminal, over SSH and on servers.</p>
			</figcaption>
		</figure>
	</div>
	<p class="hp-aside"><strong>Web dashboard</strong> · Trends over time by data type, destination such as OpenAI or Anthropic, and source app.</p>
</Section>
