---
import Section from './Section.astro';
import { LINKS } from './links';

const steps = [
	{ title: 'Intercept', text: 'Requests reach Shadow through <code>HTTPS_PROXY</code>, a gateway base URL or the Rust API. Only known AI hosts are decrypted; everything else is tunnelled untouched.' },
	{ title: 'Detect', text: 'Checksummed patterns, emails, phones, secrets, hostnames, IPs and paths, your own dictionary of customers and codenames, and optional local NER or Presidio.' },
	{ title: 'Translate', text: 'Each value gets a consistent, format-preserving fake from your machine’s persona, or a typed token for bulk reports. Secrets can be redacted outright.' },
	{ title: 'Restore', text: 'Fakes in the answer are turned back into real values: full responses, streamed tokens and tool-call arguments, before your tool sees them.' },
];
---

<Section
	id="how-it-works"
	eyebrow="How it works"
	title="Translate, don’t block"
	lead="Shadow sits between your tools and the model. The provider gets a coherent prompt about a company that does not exist. You get an answer about yours."
>
	<div class="hp-flow" role="img" aria-label="Your app sends jane@acme.com to Shadow on your machine. Shadow sends hui.zhao@zhilan.cn to the LLM provider. The answer comes back with the fake, and Shadow restores jane@acme.com before your app sees it.">
		<div class="hp-flow__zone" aria-hidden="true"><span>Your machine or network</span></div>
		<div class="hp-flow__node">
			<span class="hp-flow__kicker">Your app</span>
			<strong>SDK, agent, IDE, CLI</strong>
		</div>
		<div class="hp-flow__lane" aria-hidden="true">
			<div class="hp-flow__arrow hp-flow__arrow--out"><code>jane@acme.com</code></div>
			<div class="hp-flow__arrow hp-flow__arrow--in"><code>jane@acme.com</code></div>
		</div>
		<div class="hp-flow__node hp-flow__node--shadow">
			<span class="hp-flow__kicker">Shadow</span>
			<strong>mask <span aria-hidden="true">·</span> restore</strong>
			<span class="hp-flow__vault">encrypted vault</span>
		</div>
		<div class="hp-flow__lane" aria-hidden="true">
			<div class="hp-flow__arrow hp-flow__arrow--out hp-flow__arrow--fake"><code>hui.zhao@zhilan.cn</code></div>
			<div class="hp-flow__arrow hp-flow__arrow--in hp-flow__arrow--fake"><code>hui.zhao@zhilan.cn</code></div>
		</div>
		<div class="hp-flow__node hp-flow__node--llm">
			<span class="hp-flow__kicker">LLM provider</span>
			<strong>OpenAI, Anthropic, Gemini…</strong>
		</div>
	</div>

	<div class="hp-example">
		<div class="hp-example__panel">
			<p class="hp-example__label"><span class="hp-dot hp-dot--real"></span>1 · You ask</p>
			<p class="hp-example__text">
				Draft a renewal reminder to <mark class="real">Jane Doe</mark> (<mark class="real">jane@acme.com</mark>) at
				<mark class="real">Acme GmbH</mark>. Their plan renews on 30 June.
			</p>
		</div>
		<div class="hp-example__arrow" aria-hidden="true">→</div>
		<div class="hp-example__panel hp-example__panel--fake">
			<p class="hp-example__label"><span class="hp-dot hp-dot--fake"></span>2 · The provider sees</p>
			<p class="hp-example__text">
				Draft a renewal reminder to <mark class="fake">Hui Zhao</mark> (<mark class="fake">hui.zhao@zhilan.cn</mark>) at
				<mark class="fake">Zhilan GmbH</mark>. Their plan renews on 30 June.
			</p>
		</div>
		<div class="hp-example__arrow" aria-hidden="true">→</div>
		<div class="hp-example__panel">
			<p class="hp-example__label"><span class="hp-dot hp-dot--real"></span>3 · You get back</p>
			<p class="hp-example__text">
				To: <mark class="real">jane@acme.com</mark><br />
				Hi <mark class="real">Jane Doe</mark>, a quick reminder that the <mark class="real">Acme GmbH</mark> plan renews on
				30 June. Reply to this email if anything should change.
			</p>
		</div>
	</div>
	<ul class="hp-example__notes">
		<li><strong>The goal survives.</strong> The model writes about a stand-in; the draft you read and send names the real Jane.</li>
		<li><strong>Same shape, same fake.</strong> Emails stay emails and cards pass Luhn, and a value always maps to the same fake.</li>
		<li><strong>Intent-aware.</strong> If the provider itself sends the email through a hosted tool, the recipient and names it needs stay real and each one is logged; secrets stay masked. <a href={LINKS.intent}>How intent works</a></li>
	</ul>

	<ol class="hp-grid hp-grid--4 hp-steps">
		{
			steps.map((s, i) => (
				<li class="hp-card hp-step">
					<span class="hp-step__num">{String(i + 1).padStart(2, '0')}</span>
					<h3>{s.title}</h3>
					<p set:html={s.text} />
				</li>
			))
		}
	</ol>
	<p class="hp-section__more"><a href={LINKS.howItWorks}>Read the full request lifecycle <span aria-hidden="true">→</span></a></p>
</Section>
