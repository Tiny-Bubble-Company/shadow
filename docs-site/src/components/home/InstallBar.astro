---
// One-line install command with a copy button (works without JS: the command is selectable).
import { Icon } from '@astrojs/starlight/components';
import { LINKS } from './links';

const cmd = 'curl -fsSL https://raw.githubusercontent.com/Tiny-Bubble-Company/shadow/main/packaging/install.sh | sh';
---

<div class="hp-install not-content">
	<div class="hp-install__bar">
		<span class="hp-install__label">Install</span>
		<code class="hp-install__cmd"><span aria-hidden="true">$ </span>{cmd}</code>
		<button type="button" class="hp-install__copy" data-copy={cmd} aria-label="Copy install command">
			<Icon name="document" size="1rem" />
			<span data-copy-label>Copy</span>
		</button>
	</div>
	<p class="hp-install__alt">
		macOS and Linux. Windows, Cargo and Docker: see <a href={LINKS.installation}>installation</a>. Source on <a href={LINKS.repo} rel="noopener">GitHub</a>.
	</p>
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>('.hp-install__copy').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const label = btn.querySelector('[data-copy-label]');
			try {
				await navigator.clipboard.writeText(btn.dataset.copy ?? '');
				if (label) label.textContent = 'Copied';
			} catch {
				if (label) label.textContent = 'Select and copy';
			}
			setTimeout(() => label && (label.textContent = 'Copy'), 2000);
		});
	});
</script>
