---
// Home page research section: the three newest articles as hairline cells.
import { getResearch } from '../../data/research';
import { sitePath } from '../../nav/site-nav';
import ResearchCards from '../research/ResearchCards.astro';

const articles = (await getResearch()).slice(0, 3);
---

{
	articles.length > 0 && (
		<section id="research" class="hp-sec reveal" aria-labelledby="research-heading">
			<div class="hp-wrap">
				<header class="hp-head">
					<p class="hp-eyebrow">Research</p>
					<h2 id="research-heading" class="hp-h2 text-fade">
						Evidence-based AI privacy analysis
					</h2>
					<p class="hp-lead">
						ktanaka AI coding tools and chat assistants can expose, measured and documented. From the Shadow team.
					</p>
				</header>
				<ResearchCards entries={articles} columns={3} />
				<a class="hp-more" href={sitePath('/research/')}>
					Browse all research <span aria-hidden="true">→</span>
				</a>
			</div>
		</section>
	)
}
