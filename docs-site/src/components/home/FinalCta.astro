---
import { Icon } from '@astrojs/starlight/components';
import { LINKS } from './links';

const next = [
	{ title: 'Quick start', text: 'Install, start the proxy and send your first protected request in five minutes.', link: LINKS.quickStart },
	{ title: 'Installation', text: 'Install script, Cargo, Docker and running Shadow as a service.', link: LINKS.installation },
	{ title: 'Introduction', text: 'What Shadow is, what it is not, and the three ways to run it.', link: LINKS.introduction },
];
---

<section class="hp-cta not-content" aria-labelledby="get-started">
	<div class="hp-cta__copy">
		<h2 id="get-started">Keep using AI. Keep your data.</h2>
		<p>Free and open source under Apache-2.0. One binary, no account, nothing to sign up for.</p>
		<div class="hp-cta__actions">
			<a class="hp-btn hp-btn--primary" href={LINKS.quickStart}>
				Get started <Icon name="right-arrow" size="1.1rem" />
			</a>
			<a class="hp-btn hp-btn--ghost" href={LINKS.repo} rel="noopener">
				<Icon name="github" size="1.1rem" /> Star on GitHub
			</a>
		</div>
	</div>
	<ul class="hp-cta__next">
		{
			next.map((n) => (
				<li>
					<a href={n.link}>
						<strong>
							{n.title} <span aria-hidden="true">→</span>
						</strong>
						<span>{n.text}</span>
					</a>
				</li>
			))
		}
	</ul>
</section>
