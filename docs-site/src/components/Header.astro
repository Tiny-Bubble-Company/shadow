---
// Site header for the home page and every docs page (overrides Starlight's Header).
// 56px translucent bar: logo · menu (Products, Solutions, Docs, Pricing, Compare, Trust) · search ·
// GitHub · the buyer CTA · "Install Core free". Also mounts the funnel tracking and the waitlist/demo form once. Menus are <details>; a small script only closes them on Escape,
// outside click or when another one opens. Below 75rem the groups move into one "Menu"
// panel (on docs pages under 50rem Starlight's own sidebar menu takes over).
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import { Icon } from '@astrojs/starlight/components';
import { REPO_URL } from '../site.mjs';
import { CORE_CTA } from '../data/hub';
import { mainNav, sitePath, type NavGroup } from '../nav/site-nav';
import HubCta from './HubCta.astro';
import HubForm from './HubForm.astro';

const nav = await mainNav();
type Menu = { id: string; label: string; wide?: boolean; products?: boolean; columns?: NavGroup[]; href?: string; all?: { label: string; href: string } };
const menus: Menu[] = [
	{ id: 'products', label: 'Products', wide: true, products: true, columns: nav.products, all: { label: 'Compare Core, Hub and Connect pricing', href: sitePath('/pricing/') } },
	{ id: 'solutions', label: 'Solutions', wide: true, columns: nav.solutions.columns },
	{ id: 'docs', label: 'Docs', wide: true, columns: nav.docs.columns },
	{ id: 'pricing', label: 'Pricing', href: sitePath('/pricing/') },
	{
		id: 'compare',
		label: 'Compare',
		wide: true,
		columns: [nav.compare],
		all: nav.compare.href ? { label: 'Compare all AI data-leak tools', href: nav.compare.href } : undefined,
	},
	{ id: 'trust', label: 'Trust', href: sitePath('/trust/') },
];
const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class:list={['sh-header', { 'has-sidebar': hasSidebar }]}>
	<div class="sh-header__title">
		<SiteTitle />
	</div>

	<nav class="sh-nav" aria-label="Main">
		<ul class="sh-nav__list">
			{
				menus.map((m) => m.href ? (
					<li>
						<a class="sh-nav__link" href={m.href}>{m.label}</a>
					</li>
				) : (
					<li>
						<details class="sh-nav__item" data-sh-menu>
							<summary>
								{m.label}
								<Icon name="down-caret" size="0.9rem" class="sh-caret" />
							</summary>
							<div class:list={['sh-panel', { 'sh-panel--wide': m.wide }]}>
								<div class:list={['sh-panel__cols', `sh-panel__cols--${m.columns!.length}`, { 'sh-panel__cols--many': m.columns!.length === 1 && m.columns![0]!.links.length > 10 }]}>
									{m.columns!.map((g) => (
										<div class:list={['sh-panel__group', { 'sh-panel__product': m.products }]}>
											{m.products ? (
												<a class="sh-panel__product-head" href={g.href}>
													<span class="sh-panel__product-name">{g.label}</span>
													<span class="sh-panel__product-tag">{g.tagline}</span>
												</a>
											) : m.columns!.length > 1 && (
												<p class="sh-panel__heading">
													{g.href ? <a href={g.href}>{g.label}</a> : g.label}
												</p>
											)}
											<ul>
												{g.links.map((l) => (
													<li>
														<a href={l.href}>
															<span class="sh-panel__label">{l.label}</span>
															{m.products && l.description && <span class="sh-panel__desc">{l.description}</span>}
														</a>
													</li>
												))}
											</ul>
										</div>
									))}
								</div>
								{m.all && (
									<a class="sh-panel__all" href={m.all.href}>
										{m.all.label} <span aria-hidden="true">→</span>
									</a>
								)}
							</div>
						</details>
					</li>
				))
			}
		</ul>
	</nav>

	<div class="sh-header__search print:hidden">
		<Search />
	</div>

	<div class="sh-header__right print:hidden">
		<a class="sh-gh" href={REPO_URL} rel="noopener">
			<Icon name="github" size="1rem" />
			<span>GitHub</span>
		</a>
		<div class="sh-header__cta"><HubCta location="header" show={['hub']} primary="install" compact /></div>
	</div>

	<a class="sh-btn sh-btn--fg sh-btn--sm sh-header__install print:hidden" href={sitePath('/getting-started/quick-start/')}>{CORE_CTA}</a>

	<details class="sh-menu print:hidden" data-sh-menu>
		<summary aria-label="Site menu">
			<Icon name="bars" size="1.25rem" class="sh-menu__open" />
			<Icon name="close" size="1.25rem" class="sh-menu__close" />
		</summary>
		<div class="sh-menu__panel">
			{
				menus.map((m) => m.href ? (
					<a class="sh-menu__link" href={m.href}>{m.label}</a>
				) : (
					<details class="sh-menu__group">
						<summary>{m.label}</summary>
						{m.columns!.map((g) => (
							<div class="sh-menu__sub">
								{(m.products || m.columns!.length > 1) && <p class="sh-panel__heading">{g.href ? <a href={g.href}>{g.label}</a> : g.label}</p>}
								<ul>
									{g.links.map((l) => (
										<li>
											<a href={l.href}>{l.label}</a>
										</li>
									))}
								</ul>
							</div>
						))}
						{m.all && (
							<a class="sh-panel__all" href={m.all.href}>
								{m.all.label} <span aria-hidden="true">→</span>
							</a>
						)}
					</details>
				))
			}
			<a class="sh-menu__link" href={sitePath('/benchmarks/')}>Benchmarks</a>
			<HubCta location="header" show={['hub', 'install']} compact />
			<div class="sh-menu__foot">
				<a class="sh-gh" href={REPO_URL} rel="noopener">
					<Icon name="github" size="1.1rem" /> <span>GitHub</span>
					<span class="sh-gh__badge">Apache-2.0</span>
				</a>
			</div>
		</div>
	</details>
</div>
<HubForm />

<script>
	import '../scripts/track';
</script>

<script>
	const menus = () => [...document.querySelectorAll<HTMLDetailsElement>('[data-sh-menu]')];
	const closeAll = (except?: Element) =>
		menus().forEach((d) => {
			if (d !== except) d.open = false;
		});
	document.addEventListener(
		'toggle',
		(e) => {
			const t = e.target as HTMLElement;
			if (t instanceof HTMLDetailsElement && t.matches('[data-sh-menu]') && t.open) closeAll(t);
		},
		true,
	);
	document.addEventListener('click', (e) => {
		const t = e.target as HTMLElement;
		if (!t.closest('[data-sh-menu]')) closeAll();
		else if (t.closest('.sh-panel a, .sh-menu__panel a')) closeAll();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		const open = menus().find((d) => d.open);
		if (open) {
			open.open = false;
			open.querySelector('summary')?.focus();
		}
	});
</script>
