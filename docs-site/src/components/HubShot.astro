---
// A Shadow Hub dashboard screenshot from public/hub/shots/, in a Linear-style frame
// (12px radius, hairline border, faint accent glow). Images are 2880x1800 (16:10).
//
//   <HubShot name="overview" alt="…" caption="…" />
interface Props {
	/** File name in public/hub/shots/ without the extension. */
	name: 'overview' | 'incidents' | 'incident-detail' | 'people' | 'insights' | 'invite';
	alt: string;
	caption?: string;
	/** hero: wider glow, more space around it. */
	variant?: 'hero' | 'default' | 'tile';
	loading?: 'lazy' | 'eager';
}

const { name, alt, caption, variant = 'default', loading = 'lazy' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const src = `${base}/hub/shots/${name}.png`;
---

<figure class:list={['hub-shot', `hub-shot--${variant}`, 'not-content']}>
	<div class="hub-shot__frame">
		<img src={src} alt={alt} width="2880" height="1800" loading={loading} decoding="async" />
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.hub-shot {
		position: relative;
		margin: 2.5rem 0;
	}
	.hub-shot--hero {
		margin: 3rem 0 1rem;
	}
	.hub-shot--tile {
		margin: 0;
	}
	/* The design system's screenshot frame: a surface card with 0.5rem padding. */
	.hub-shot__frame {
		position: relative;
		padding: 0.5rem;
		border: 1px solid var(--sh-border);
		border-radius: calc(var(--sh-radius) + 4px);
		background: var(--sh-panel);
		box-shadow: 0 30px 80px -40px var(--shadow-glow);
	}
	.hub-shot--hero .hub-shot__frame {
		box-shadow: 0 40px 140px -40px var(--shadow-glow);
	}
	.hub-shot--tile .hub-shot__frame {
		padding: 0.375rem;
		box-shadow: none;
	}
	.hub-shot img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		border-radius: var(--sh-radius);
	}
	.hub-shot figcaption {
		margin-top: 0.75rem;
		text-align: center;
		font-size: 0.875rem;
		color: var(--sh-muted);
	}
	.hub-shot--tile figcaption {
		text-align: start;
		font-size: 0.8125rem;
	}
</style>
