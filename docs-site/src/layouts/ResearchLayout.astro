---
// Editorial layout for research articles: no sidebar, focused reading experience.
// Inspired by OpenAI's research pages but with Shadow's design language.
import type { ResearchFrontmatter } from '../content/config';
import { HOME_URL, SITE_NAME, TAGLINE, SITE_DESCRIPTION, ORG_NAME, REPO_URL, SUPPORT_EMAIL } from '../site.mjs';
import { sitePath } from '../nav/site-nav';
import SiteFooter from '../components/SiteFooter.astro';
import FaqSection from '../components/FaqSection.astro';
import ResearchHighlights from '../components/research/ResearchHighlights.astro';

interface Props {
	frontmatter: ResearchFrontmatter;
	slug: string;
	headings?: { depth: number; slug: string; text: string }[];
}

const { frontmatter, slug, headings = [] } = Astro.props;
const canonicalUrl = frontmatter.canonical || `${HOME_URL}research/${slug}/`;
const ogImage = frontmatter.ogImage ? (frontmatter.ogImage.startsWith('http') ? frontmatter.ogImage : `${HOME_URL}${frontmatter.ogImage.replace(/^\//, '')}`) : `${HOME_URL}og/research.png`;

const title = frontmatter.seoTitle || frontmatter.title;
const pageTitle = `${title} · ${SITE_NAME} Research`;

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const publishedIso = frontmatter.publishedDate.toISOString();
const updatedIso = frontmatter.updatedDate?.toISOString();

const readingTime = frontmatter.readingTime || Math.ceil(800 / 200);

const breadcrumbs = [
	{ name: SITE_NAME, url: HOME_URL },
	{ name: 'Research', url: `${HOME_URL}research/` },
	{ name: frontmatter.title, url: canonicalUrl },
];

const orgId = `${HOME_URL}#organization`;
const articleId = `${canonicalUrl}#article`;
const breadcrumbId = `${canonicalUrl}#breadcrumb`;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': orgId,
			name: ORG_NAME,
			url: HOME_URL,
			logo: { '@type': 'ImageObject', url: `${HOME_URL}logo.png`, width: 512, height: 512 },
			email: SUPPORT_EMAIL,
		},
		{
			'@type': 'Article',
			'@id': articleId,
			headline: frontmatter.title,
			description: frontmatter.description,
			url: canonicalUrl,
			mainEntityOfPage: canonicalUrl,
			inLanguage: 'en',
			datePublished: publishedIso,
			...(updatedIso && { dateModified: updatedIso }),
			author: { '@type': 'Person', name: frontmatter.author },
			publisher: { '@id': orgId },
			image: ogImage,
			...(frontmatter.keywords?.length && { keywords: frontmatter.keywords.join(', ') }),
			breadcrumb: { '@id': breadcrumbId },
		},
		{
			'@type': 'BreadcrumbList',
			'@id': breadcrumbId,
			itemListElement: breadcrumbs.map((b, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				name: b.name,
				item: b.url,
			})),
		},
		...(frontmatter.faq?.length
			? [
					{
						'@type': 'FAQPage',
						'@id': `${canonicalUrl}#faq`,
						url: canonicalUrl,
						mainEntity: frontmatter.faq.map(({ q, a }) => ({
							'@type': 'Question',
							name: q,
							acceptedAnswer: { '@type': 'Answer', text: a },
						})),
					},
				]
			: []),
	],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={frontmatter.description} />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Open Graph -->
		<meta property="og:type" content="article" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={frontmatter.description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content={`${SITE_NAME} Research`} />
		<meta property="article:published_time" content={publishedIso} />
		{updatedIso && <meta property="article:modified_time" content={updatedIso} />}
		{frontmatter.topics.map((topic) => <meta property="article:tag" content={topic} />)}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={frontmatter.description} />
		<meta name="twitter:image" content={ogImage} />

		{frontmatter.keywords?.length > 0 && <meta name="keywords" content={frontmatter.keywords.join(', ')} />}

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
		<meta name="theme-color" content="#7C6CFF" />

		<!-- Fonts (same as docs) -->
		<style is:global>
			@import '@fontsource-variable/geist';
			@import '@fontsource-variable/geist-mono';
		</style>

		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<link rel="alternate" type="text/plain" title="llms.txt" href={sitePath('/llms.txt')} />
	</head>

	<body>
		<a href="#main" class="skip-link">Skip to content</a>

		<header class="research-header">
			<nav class="research-header__inner" aria-label="Research navigation">
				<a class="research-header__logo" href={sitePath('/')}>
					<img src={sitePath('/favicon.svg')} alt="" width="24" height="24" />
					<span>Shadow</span>
				</a>
				<a class="research-header__link" href={sitePath('/research/')}>Research</a>
				<a class="research-header__link" href={sitePath('/getting-started/introduction/')}>Docs</a>
				<a class="research-header__link" href={sitePath('/hub/')}>Hub</a>
				<a class="research-header__link" href={REPO_URL} rel="noopener">GitHub</a>
			</nav>
		</header>

		<main id="main" class="research-main">
			<article class="research-article">
				<header class="research-hero">
					<nav class="research-breadcrumb" aria-label="Breadcrumb">
						<ol>
							<li><a href={sitePath('/')}>Shadow</a></li>
							<li><a href={sitePath('/research/')}>Research</a></li>
						</ol>
					</nav>

					{
						frontmatter.series && (
							<p class="research-series">
								{frontmatter.series}
								{frontmatter.seriesNumber && <span>#{frontmatter.seriesNumber}</span>}
							</p>
						)
					}

					<h1 class="research-title">{frontmatter.title}</h1>
					<p class="research-dek">{frontmatter.description}</p>

					<div class="research-meta">
						<span class="research-meta__author">{frontmatter.author}</span>
						<span class="research-meta__sep">·</span>
						<time datetime={publishedIso}>{formatDate(frontmatter.publishedDate)}</time>
						<span class="research-meta__sep">·</span>
						<span>{readingTime} min read</span>
					</div>

					{
						frontmatter.topics.length > 0 && (
							<ul class="research-topics" aria-label="Topics">
								{frontmatter.topics.map((topic) => (
									<li>
										<a href={`${sitePath('/research/')}?topic=${encodeURIComponent(topic)}`}>{topic}</a>
									</li>
								))}
							</ul>
						)
					}
				</header>

				{
					frontmatter.keyFindings.length > 0 && (
						<aside class="research-highlights">
							<ResearchHighlights findings={frontmatter.keyFindings} />
						</aside>
					)
				}

				<div class="research-content sl-markdown-content">
					<slot />
				</div>

				{
					frontmatter.methodology && (
						<aside class="research-methodology">
							<h2>Methodology and caveats</h2>
							<div set:html={frontmatter.methodology} />
						</aside>
					)
				}

				{frontmatter.faq && frontmatter.faq.length > 0 && <FaqSection items={frontmatter.faq} />}

				{
					frontmatter.cta && (
						<div class="research-cta">
							<a href={sitePath(frontmatter.cta.href)} class="research-cta__btn">
								{frontmatter.cta.label}
							</a>
						</div>
					)
				}
			</article>
		</main>

		<SiteFooter />
	</body>
</html>

<style is:global>
	@import '../styles/custom.css';
</style>

<style>
	:root {
		--research-max-width: 42rem;
		--research-wide-width: 54rem;
	}

	.skip-link {
		position: absolute;
		top: -100%;
		left: 1rem;
		z-index: 1000;
		padding: 0.5rem 1rem;
		background: var(--sh-accent);
		color: var(--sh-on-accent);
		border-radius: 4px;
	}
	.skip-link:focus {
		top: 1rem;
	}

	.research-header {
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		border-bottom: 1px solid var(--sh-border);
		background: var(--sl-color-bg-nav);
	}

	.research-header__inner {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		max-width: var(--research-wide-width);
		margin: 0 auto;
		padding: 0.875rem 1.5rem;
	}

	.research-header__logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 500;
		font-size: 0.9375rem;
		color: var(--sh-text);
		text-decoration: none;
	}

	.research-header__logo:hover {
		color: var(--sh-accent-text);
	}

	.research-header__link {
		font-size: 0.875rem;
		color: var(--sh-muted);
		text-decoration: none;
		transition: color var(--sh-ease);
	}

	.research-header__link:hover {
		color: var(--sh-text);
	}

	.research-main {
		min-height: 100vh;
		background: var(--sh-bg);
	}

	.research-article {
		max-width: var(--research-wide-width);
		margin: 0 auto;
		padding: 0 1.5rem 4rem;
	}

	.research-hero {
		padding: 4rem 0 3rem;
		border-bottom: 1px solid var(--sh-border);
		margin-bottom: 3rem;
	}

	@media (min-width: 50rem) {
		.research-hero {
			padding: 5rem 0 3.5rem;
		}
	}

	.research-breadcrumb ol {
		display: flex;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem;
		font-size: 0.8125rem;
		color: var(--sh-muted);
	}

	.research-breadcrumb li:not(:last-child)::after {
		content: '/';
		margin-left: 0.5rem;
		color: var(--sh-faint);
	}

	.research-breadcrumb a {
		color: inherit;
		text-decoration: none;
	}

	.research-breadcrumb a:hover {
		color: var(--sh-text);
	}

	.research-series {
		display: inline-flex;
		gap: 0.35rem;
		margin: 0 0 1rem;
		padding: 0.25rem 0.75rem;
		background: var(--sh-accent-soft);
		border-radius: 100px;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--sh-accent-text);
	}

	.research-title {
		margin: 0 0 1rem;
		font-size: clamp(1.75rem, 5vw, 2.5rem);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.035em;
		color: var(--sh-text);
	}

	.research-dek {
		margin: 0 0 1.5rem;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--sh-muted);
		max-width: var(--research-max-width);
	}

	.research-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--sh-muted);
	}

	.research-meta__author {
		font-weight: 500;
		color: var(--sh-text);
	}

	.research-meta__sep {
		color: var(--sh-faint);
	}

	.research-topics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 0;
	}

	.research-topics a {
		display: block;
		padding: 0.25rem 0.625rem;
		background: var(--sh-raised);
		border: 1px solid var(--sh-border);
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--sh-muted);
		text-decoration: none;
		transition:
			background-color var(--sh-ease),
			border-color var(--sh-ease),
			color var(--sh-ease);
	}

	.research-topics a:hover {
		background: var(--sh-hover);
		border-color: var(--sh-border-strong);
		color: var(--sh-text);
	}

	.research-highlights {
		margin-bottom: 3rem;
	}

	.research-content {
		max-width: var(--research-max-width);
		font-size: 1.0625rem;
		line-height: 1.7;
	}

	.research-content :global(h2) {
		margin-top: 3rem;
		margin-bottom: 1rem;
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: -0.025em;
	}

	.research-content :global(h3) {
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.research-content :global(p) {
		margin-bottom: 1.25rem;
		color: var(--sl-color-gray-2);
	}

	.research-content :global(ul),
	.research-content :global(ol) {
		margin-bottom: 1.25rem;
		padding-left: 1.25rem;
	}

	.research-content :global(li) {
		margin-bottom: 0.5rem;
		color: var(--sl-color-gray-2);
	}

	.research-content :global(a) {
		color: var(--sh-accent-text);
		text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
		text-underline-offset: 0.2em;
	}

	.research-content :global(a:hover) {
		text-decoration-color: currentColor;
	}

	.research-content :global(strong) {
		font-weight: 600;
		color: var(--sh-text);
	}

	.research-content :global(code:not(pre code)) {
		background: var(--sh-raised);
		border: 1px solid var(--sh-border);
		border-radius: 4px;
		padding: 0.1em 0.35em;
		font-size: 0.875em;
	}

	.research-content :global(pre) {
		margin: 1.5rem 0;
		padding: 1rem 1.25rem;
		background: var(--sh-panel);
		border: 1px solid var(--sh-border);
		border-radius: 8px;
		overflow-x: auto;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.research-content :global(hr) {
		margin: 3rem 0;
		border: none;
		border-top: 1px solid var(--sh-border);
	}

	.research-content :global(blockquote) {
		margin: 1.5rem 0;
		padding: 1rem 1.25rem;
		background: var(--sh-panel);
		border-left: 3px solid var(--sh-accent);
		border-radius: 0 8px 8px 0;
	}

	.research-content :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.research-methodology {
		margin: 3rem 0;
		padding: 1.5rem;
		background: var(--sh-panel);
		border: 1px solid var(--sh-border);
		border-radius: var(--sh-radius);
		max-width: var(--research-max-width);
	}

	.research-methodology h2 {
		margin: 0 0 1rem;
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--sh-text);
	}

	.research-methodology :global(p) {
		margin: 0 0 0.75rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--sh-muted);
	}

	.research-methodology :global(p:last-child) {
		margin-bottom: 0;
	}

	.research-methodology :global(strong) {
		color: var(--sh-text);
	}

	.research-methodology :global(ul) {
		margin: 0.75rem 0;
		padding-left: 1.25rem;
	}

	.research-methodology :global(li) {
		margin-bottom: 0.35rem;
		font-size: 0.9375rem;
		color: var(--sh-muted);
	}

	.research-cta {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--sh-border);
		max-width: var(--research-max-width);
	}

	.research-cta__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		background: var(--sh-accent);
		color: var(--sh-on-accent);
		border-radius: calc(var(--sh-radius) - 2px);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			background-color var(--sh-ease),
			transform var(--sh-ease);
	}

	.research-cta__btn:hover {
		background: var(--sh-accent-hover);
	}

	:global(.faq) {
		max-width: var(--research-max-width);
	}
</style>
