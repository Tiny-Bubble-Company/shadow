---
// Research index at /research/: every article as a card, then one section per topic (the
// targets of the topic links on articles), then the FAQ. Same Starlight shell and marketing
// hero as Hub, Pricing and Trust; JSON-LD (CollectionPage, BreadcrumbList, FAQPage) comes from
// src/seo/middleware.ts.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getResearch, researchPath } from '../../data/research';
import { PRIMARY_TOPICS } from '../../data/research-topics';
import { sitePath } from '../../nav/site-nav';
import ResearchCards from '../../components/research/ResearchCards.astro';

const articles = await getResearch();
const topics = PRIMARY_TOPICS.map((t) => ({ ...t, articles: articles.filter((a) => a.data.topics.includes(t.label)) })).filter(
	(t) => t.articles.length > 0,
);

const faq = [
	{
		q: 'What does Shadow Research cover?',
		a: 'Evidence-based analysis of AI data privacy: what tools such as ChatGPT, Cursor and Claude Code send to model providers, what their privacy settings do and do not control, and practical ways to keep sensitive data out of prompts.',
	},
	{
		q: 'How can I protect my data when using AI coding assistants?',
		a: 'Keep secrets out of the workspace, turn on privacy modes where they exist, and route traffic through a masking proxy such as [Shadow](/shadow/getting-started/introduction/), which replaces sensitive values before a prompt leaves your machine. See [Does Cursor train on my code?](/shadow/research/does-cursor-train-on-my-code/).',
	},
	{
		q: 'Does ChatGPT train on my company data?',
		a: 'Free, Plus and Pro chats can be used for training unless you opt out; Business, Enterprise and the API are not used for training by default. See [Is ChatGPT safe for company data?](/shadow/research/is-chatgpt-safe-for-company-data/).',
	},
	{
		q: 'What is shadow AI and why does it matter?',
		a: 'Shadow AI is AI use at work that IT does not know about: personal ChatGPT accounts, browser extensions, coding agents with personal keys. Company and customer data can reach providers with no contract or visibility. See [What is shadow AI?](/shadow/research/what-is-shadow-ai/).',
	},
];
---

<StarlightPage
	frontmatter={{
		title: 'AI privacy research',
		seoTitle: 'AI privacy research: what AI tools expose · Shadow',
		description:
			'Evidence-based research on AI data privacy: what ChatGPT, Cursor and coding agents send to model providers, and how to keep sensitive data out of prompts.',
		template: 'splash',
		editUrl: false,
		faq,
	}}
>
	<p>
		<strong>What AI coding assistants and chat tools can expose, measured and documented.</strong> Analysis and practical
		guidance from the Shadow team, with sources and caveats.
	</p>

	<ul class="rs-tags rs-tags--center not-content" aria-label="Topics">
		{
			topics.map((t) => (
				<li>
					<a href={`#${t.slug}`}>
						{t.label} <span class="rs-tags__count">{t.articles.length}</span>
					</a>
				</li>
			))
		}
	</ul>

	<div class="sl-heading-wrapper level-h2"><h2 id="latest">Latest research</h2></div>
	<ResearchCards entries={articles} />

	{
		topics.map((t) => (
			<>
				<div class="sl-heading-wrapper level-h2"><h2 id={t.slug}>{t.label}</h2></div>
				<p>{t.description}</p>
				<ul class="rs-list not-content">
					{t.articles.map((a) => (
						<li>
							<a href={researchPath(a.id)}>{a.data.title}</a>
						</li>
					))}
				</ul>
			</>
		))
	}

	<div class="sl-heading-wrapper level-h2"><h2 id="guides">Guides and use cases</h2></div>
	<p>Step-by-step setups for the risks the research describes.</p>
	<ul class="rs-list not-content">
		<li><a href={sitePath('/use-cases/protect-secrets-from-ai-coding-assistants/')}>Protect secrets from AI coding assistants</a></li>
		<li><a href={sitePath('/use-cases/stop-pii-leaks-to-chatgpt/')}>Stop PII leaks to ChatGPT</a></li>
		<li><a href={sitePath('/use-cases/anonymize-prompts-for-claude/')}>Anonymize prompts for Claude</a></li>
		<li><a href={sitePath('/concepts/how-it-works/')}>How Shadow masks and restores data</a></li>
		<li><a href={sitePath('/compare/')}>Compare AI data-leak tools</a></li>
	</ul>
</StarlightPage>
